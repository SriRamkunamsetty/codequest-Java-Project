<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>CodeQuest - Programming Learning Game</display-name>
    <description>Interactive web-based gamified programming platform</description>

    <!-- ======================================================== -->
    <!-- ServletContext Global Application Parameters             -->
    <!-- Demonstrates ServletContext configuration               -->
    <!-- ======================================================== -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>CodeQuest - Programming Learning Game</param-value>
    </context-param>
    <context-param>
        <param-name>appVersion</param-name>
        <param-value>1.0-RELEASE</param-value>
    </context-param>
    <context-param>
        <param-name>dbUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/codequest_db?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC&amp;characterEncoding=UTF-8</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>moksha24491a44d6@</param-value>
    </context-param>

    <!-- ======================================================== -->
    <!-- Servlet Declarations & Init-Params (ServletConfig)       -->
    <!-- ======================================================== -->

    <!-- Module 2: Registration -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.codequest.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Module 3: Student Login & Logout -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Module 4: Admin Login & Dashboard (Demonstrating ServletConfig) -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AdminLoginServlet</servlet-class>
        <init-param>
            <param-name>adminPortalTitle</param-name>
            <param-value>CodeQuest HQ Command Center</param-value>
        </init-param>
        <init-param>
            <param-name>securityTier</param-name>
            <param-value>Strict Role-Based Access Control</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin-login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AdminLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <url-pattern>/admin-logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin-dashboard</url-pattern>
    </servlet-mapping>

    <!-- Module 6 & 7: Admin Question Creation & Management -->
    <servlet>
        <servlet-name>AddQuestionServlet</servlet-name>
        <servlet-class>com.codequest.servlet.AddQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddQuestionServlet</servlet-name>
        <url-pattern>/add-question</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewQuestionsServlet</servlet-name>
        <servlet-class>com.codequest.servlet.ViewQuestionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewQuestionsServlet</servlet-name>
        <url-pattern>/view-questions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteQuestionServlet</servlet-name>
        <servlet-class>com.codequest.servlet.DeleteQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteQuestionServlet</servlet-name>
        <url-pattern>/delete-question</url-pattern>
    </servlet-mapping>

    <!-- Module 8: Student Dashboard & Progress Tracking -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.codequest.servlet.DashboardServlet</servlet-class>
        <init-param>
            <param-name>motivationalTag</param-name>
            <param-value>Master programming concepts and dominate the global rankings!</param-value>
        </init-param>
        <init-param>
            <param-name>xpStepPerLevel</param-name>
            <param-value>100</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Module 9: Programming Missions Display -->
    <servlet>
        <servlet-name>MissionServlet</servlet-name>
        <servlet-class>com.codequest.servlet.MissionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MissionServlet</servlet-name>
        <url-pattern>/missions</url-pattern>
    </servlet-mapping>

    <!-- Module 10: Answer Evaluation & XP Rewards -->
    <servlet>
        <servlet-name>SubmitAnswerServlet</servlet-name>
        <servlet-class>com.codequest.servlet.SubmitAnswerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SubmitAnswerServlet</servlet-name>
        <url-pattern>/submit-answer</url-pattern>
    </servlet-mapping>

    <!-- Module 11: Global Leaderboard -->
    <servlet>
        <servlet-name>LeaderboardServlet</servlet-name>
        <servlet-class>com.codequest.servlet.LeaderboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeaderboardServlet</servlet-name>
        <url-pattern>/leaderboard</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
